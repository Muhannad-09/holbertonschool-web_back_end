{
  "name": "holberton-nodejs-basic",
  "version": "1.0.0",
  "description": "Holberton NodeJS basic project",
  "main": "full_server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node full_server/server.js database.csv",
    "dev": "nodemon --exec babel-node --presets babel-preset-env ./full_server/server.js ./database.csv"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "nodemon": "^3.1.7"
  }
}
